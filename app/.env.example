# Postgres connection string from your Supabase project (Project Settings > Database >
# Connection string > "Transaction" pooler is fine for serverless hosting).
DATABASE_URL=
# A second Postgres URL, distinct from DATABASE_URL, that the test suite is allowed to
# wipe. Point it at the SAME Supabase project with a separate schema so no extra project
# is needed, e.g. the same connection string with `&schema=test` appended, or `?schema=test`
# if DATABASE_URL has no query params yet. resetTestDb() truncates every table here on
# every test run — never point this at DATABASE_URL.
TEST_DATABASE_URL=

# Supabase project URL and anon (public) key, from Project Settings > API. Safe to
# expose to the browser (NEXT_PUBLIC_ prefix) — access is governed by Supabase Auth, not
# by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

OPENAI_API_KEY=
OPENAI_MODEL_ID=
OPENAI_REQUEST_TIMEOUT_MS=
APP_BASE_URL=
BUYER_LINK_SIGNING_SECRET=
MODEL_GATEWAY=
